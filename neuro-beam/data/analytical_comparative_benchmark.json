  "conclusions": [
    {
      "finding": "Nonlinear modelling improves internal prediction.",
      "evidence": "ExtraTrees is the best broad benchmark model (mean Spearman 0.612, mean R\u00b2 0.341)."
    },
    {
      "finding": "Predictability is strongly trait-dependent.",
      "evidence": "Best grouped-CV trait: upstroke_downstroke_ratio_long_square (Spearman 0.909, R\u00b2 0.732); weakest: vrest (Spearman 0.325)."
    },
    {
      "finding": "Several electrical phenotypes generalize across cortical regions, but not all.",
      "evidence": "Best external M1 |Spearman|: upstroke_downstroke_ratio_long_square=0.627; weakest: threshold_v_long_square=0.185; only 3/9 traits have positive external R\u00b2."
    },
    {
      "finding": "Permutation controls support genuine transcriptome\u2013electrophysiology signal.",
      "evidence": "Mean grouped Spearman=0.671, mean permuted=0.006, mean signal-null delta=0.665."
    },
    {
      "finding": "Subject grouping has little inflation relative to naive splitting in this dataset.",
      "evidence": "Mean naive-minus-grouped delta=-0.0001; max absolute delta=0.0085. Grouped splitting remains the valid design."
    },
    {
      "finding": "Uncertainty coverage is well aligned with nominal targets.",
      "evidence": "Mean empirical coverage: 90% target=0.900; 95% target=0.949."
    },
    {
      "finding": "Cancer-informed joint factorization does not improve external neuronal prediction.",
      "evidence": "Raw mean external Spearman=0.397; joint-factor=0.396; delta=-0.0009."
    },
    {
      "finding": "Gene-level evidence includes an externally replicated core, not just discovery ranking.",
      "evidence": "25 Tier-A replicated genes, 51 Tier-B robust genes; 473 genes evaluated in M1 replication."
    }
  ],
