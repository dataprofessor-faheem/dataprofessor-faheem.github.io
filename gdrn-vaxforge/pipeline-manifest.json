{
  "schema": "gdrn.vaxforge.pipeline_manifest.v1",
  "release": "0.3.0",
  "as_of": "2026-11-07",
  "scope": "Analysis-ready live-browser descriptive sequence workbench; external vaccine pipelines are planned, not active.",
  "data_policy": "Input FASTA remains in browser. Explicit accession lookups call UniProt REST using accession only.",
  "nodes": [
    {
      "id": "input_qc",
      "depends_on": [],
      "status": "implemented_browser",
      "output": "Validated protein, DNA or RNA FASTA, duplicate counts, sequence lengths, GC"
    },
    {
      "id": "public_accession",
      "depends_on": [],
      "status": "browser_api_implemented_network_not_independently_verified",
      "output": "Single UniProtKB FASTA imported by accession"
    },
    {
      "id": "msa",
      "depends_on": [
        "input_qc"
      ],
      "status": "requires_precomputed_external_alignment",
      "output": "User-supplied MSA only"
    },
    {
      "id": "conservation",
      "depends_on": [
        "msa"
      ],
      "status": "implemented_browser",
      "output": "Per-position consensus, occupancy, entropy, variants and conserved windows"
    },
    {
      "id": "pairwise",
      "depends_on": [
        "msa"
      ],
      "status": "implemented_browser_bounded",
      "output": "Pairwise identity and compared-site counts"
    },
    {
      "id": "genome_wide_pangenome",
      "depends_on": [
        "public_accession"
      ],
      "status": "not_implemented",
      "output": null
    },
    {
      "id": "antigen_prioritization",
      "depends_on": [
        "genome_wide_pangenome"
      ],
      "status": "not_implemented",
      "output": null
    },
    {
      "id": "mhci_prediction",
      "depends_on": [
        "antigen_prioritization"
      ],
      "status": "not_implemented",
      "output": null
    },
    {
      "id": "mhcii_and_bcell",
      "depends_on": [
        "antigen_prioritization"
      ],
      "status": "not_implemented",
      "output": null
    },
    {
      "id": "construct_design",
      "depends_on": [
        "mhci_prediction",
        "mhcii_and_bcell"
      ],
      "status": "not_implemented",
      "output": null
    },
    {
      "id": "benchmarks",
      "depends_on": [],
      "status": "research_core_only_not_executed_for_vaccine_models",
      "output": null
    },
    {
      "id": "export",
      "depends_on": [
        "input_qc",
        "conservation"
      ],
      "status": "implemented_browser",
      "output": "JSON + CSV"
    },
    {
      "id": "experimental_validation",
      "depends_on": [],
      "status": "not_implemented_requires_experimental_study",
      "output": null
    }
  ],
  "gates": [
    "GitHub Actions smoke tests must pass before merge",
    "GitHub Pages deployment must succeed",
    "Third-party CORS and external service availability independently verify",
    "Experimental datasets required before predictive claims"
  ],
  "references": [
    "https://doi.org/10.3390/vaccines11061090",
    "https://nextgen-tools.iedb.org/docs/api/endpoints/",
    "https://www.ncbi.nlm.nih.gov/home/develop/api/"
  ]
}
